{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "check": {},
    "format": {
      "cache": false
    },
    "generate-routes": {
      "cache": false
    },
    "schema:print": {
      "outputs": ["schema.graphql"]
    },
    "codegen": {
      "dependsOn": ["api#schema:print"],
      "outputs": ["src/graphql/generated/**"]
    }
  }
}
