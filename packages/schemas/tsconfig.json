{
	"include": ["src"],
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"lib": ["ES2023", "DOM"],

		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
