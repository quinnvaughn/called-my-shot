{
  "name": "called-my-shot",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "format": "turbo run format",
    "deploy": "pnpm run deploy:api && pnpm run deploy:web",
    "deploy:api": "fly deploy --config apps/api/fly.toml",
    "deploy:web": "pnpm --filter web run check:schema && fly deploy --config apps/web/fly.toml"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@11.20.0"
}
