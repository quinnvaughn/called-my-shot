DATABASE_URL=postgres://postgres:postgres@localhost:5433/called_my_shot
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Mail. With no RESEND_API_KEY, sendMail prints what it would have sent to the
# console instead of delivering - which is the intended local setup, so none of
# these are needed to run the app.
RESEND_API_KEY=
EMAIL_FROM="Called My Shot <noreply@mail.calledmyshot.com>"
# Same verified domain as EMAIL_FROM today, different From address. Split onto
# its own subdomain when you want digest complaints isolated from auth mail.
EMAIL_FROM_NOTIFICATIONS="Called My Shot <results@mail.calledmyshot.com>"
SUPPORT_EMAIL=support@calledmyshot.com
# Signs one-click unsubscribe links. Required in production, ignored locally.
# Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=
# Resend webhook signing secret ("whsec_..."), from the endpoint you add in the
# Resend dashboard pointing at https://<host>/webhooks/resend. Without it the
# webhook route rejects everything rather than trusting an unverified payload.
RESEND_WEBHOOK_SECRET=
