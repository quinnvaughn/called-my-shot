DATABASE_URL=postgres://postgres:postgres@localhost:5433/called_my_shot
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Mail. With no RESEND_API_KEY, sendMail prints what it would have sent to the
# console instead of delivering - which is the intended local setup, so none of
# these are needed to run the app.
RESEND_API_KEY=
EMAIL_FROM="Called My Shot <noreply@mail.calledmyshot.com>"
# Same verified domain as EMAIL_FROM today, different From address. Split onto
# its own subdomain when you want digest complaints isolated from auth mail.
EMAIL_FROM_NOTIFICATIONS="Called My Shot <results@mail.calledmyshot.com>"
SUPPORT_EMAIL=support@calledmyshot.com
# Signs one-click unsubscribe links. Required in production, ignored locally.
# Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=
# Resend webhook signing secret ("whsec_..."), from the endpoint you add in the
# Resend dashboard pointing at https://<host>/webhooks/resend. Without it the
# webhook route rejects everything rather than trusting an unverified payload.
RESEND_WEBHOOK_SECRET=

# Cloudflare R2, for avatars and group logos/banners. All optional locally:
# without them uploads refuse and images fall back to initials.
# R2_ACCOUNT_ID: Cloudflare dashboard > R2 overview, right sidebar.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 overview > Manage R2 API Tokens >
#   Create API token (Object Read & Write, scoped to the bucket). Use the
#   S3-compatible pair, not the "Token value".
# R2_BUCKET: the bucket name, e.g. called-my-shot-images-dev.
# R2_PUBLIC_URL: bucket > Settings > Public Development URL (r2.dev) locally,
#   the custom domain (https://images.calledmyshot.com) in production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# GIFs in gloats (https://partner.klipy.com). Unset, gloats are words only.
KLIPY_API_KEY=

# Web push. Unset, nothing is pushed and the web app never offers
# notifications. Generate a pair with: npx web-push generate-vapid-keys
# Use a separate pair locally; never rotate the production pair, since every
# device's subscription is bound to the public key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
