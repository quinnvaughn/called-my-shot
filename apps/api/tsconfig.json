{
  "include": ["src", "drizzle.config.ts"],
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    /* DOM is here for @types/react, not because anything runs in a browser -
       React 19's JSX intrinsics are typed against DOM element interfaces, and
       the email templates in src/emails are real React components. */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
