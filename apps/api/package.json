{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "schema:print": "tsx --env-file=.env src/graphql/print-schema.ts",
    "email:dev": "email dev --dir src/emails --port 3001",
    "email:logo": "tsx scripts/render-email-logo.ts",
    "backfill:emails": "tsx --env-file=.env scripts/backfill-resolution-emails.ts",
    "season-start:emails": "tsx --env-file=.env scripts/season-start-emails.ts",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "sync:sports": "tsx --env-file=.env src/db/sync/run.ts",
    "sync:live-scores": "tsx --env-file=.env src/db/sync/sync-live-scores.ts",
    "sync:game-starters": "tsx --env-file=.env src/db/sync/sync-game-starters.ts",
    "lock:overdue-questions": "tsx --env-file=.env src/db/lock-overdue-questions.ts",
    "db:sync-catalog": "tsx --env-file=.env src/db/catalog/run.ts",
    "release": "drizzle-kit migrate && tsx src/db/catalog/run.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@called-my-shot/schemas": "workspace:*",
    "@called-my-shot/scoring": "workspace:*",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-dataloader": "^4.4.5",
    "@pothos/plugin-drizzle": "^0.17.5",
    "@pothos/plugin-errors": "^4.9.1",
    "@react-email/render": "2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.1.0",
    "graphql": "^16.14.2",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-email": "6.9.3",
    "resend": "^6.20.0",
    "satori": "^0.29.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@react-email/ui": "6.9.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
