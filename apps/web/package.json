{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "build": "vite build",
    "check:schema": "tsx scripts/check-schema-compat.ts",
    "preview": "vite preview",
    "format": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@called-my-shot/schemas": "workspace:*",
    "@called-my-shot/scoring": "workspace:*",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "1.168.50",
    "@tanstack/react-store": "^0.9.3",
    "@tanstack/store": "^0.11.1",
    "graphql": "^16.14.2",
    "luxon": "^3.7.2",
    "nitro": "3.0.260610-beta",
    "posthog-js": "^1.418.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^6.2.3",
    "react-icons": "^5.7.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.2",
    "@graphql-tools/code-file-loader": "^8.1.36",
    "@graphql-tools/load": "^8.1.15",
    "@pandacss/dev": "^1.12.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/luxon": "^3.7.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "30.0.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
